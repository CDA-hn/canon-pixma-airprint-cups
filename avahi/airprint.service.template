<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  AirPrint advertisement for a CUPS queue, over plain IPP (no TLS).
  install.sh fills in the @PLACEHOLDERS@ and writes it to
  /etc/avahi/services/airprint-<queue>.service
  Key bits for iOS: _ipp._tcp + _universal subtype + URF + pdl with image/urf.
  There is deliberately NO "TLS=" key, so iPhones don't try ipps.
-->
<service-group>
  <name>@NAME@</name>
  <service>
    <type>_ipp._tcp</type>
    <subtype>_universal._sub._ipp._tcp</subtype>
    <port>631</port>
    <txt-record>txtvers=1</txt-record>
    <txt-record>qtotal=1</txt-record>
    <txt-record>rp=printers/@QUEUE@</txt-record>
    <txt-record>ty=@NAME@</txt-record>
    <txt-record>note=@LOCATION@</txt-record>
    <txt-record>priority=0</txt-record>
    <txt-record>product=(@NAME@)</txt-record>
    <txt-record>pdl=application/pdf,image/jpeg,image/png,image/pwg-raster,image/urf</txt-record>
    <txt-record>URF=@URF@</txt-record>
    <txt-record>UUID=@UUID@</txt-record>
    <txt-record>Color=@COLOR@</txt-record>
    <txt-record>Duplex=F</txt-record>
    <txt-record>Transparent=T</txt-record>
    <txt-record>Binary=T</txt-record>
    <txt-record>printer-state=3</txt-record>
    <txt-record>printer-type=0x100E</txt-record>
  </service>
</service-group>
